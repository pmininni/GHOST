! Example of parameter.inp
! Rename this file as 'parameter.inp' and place it in the same
! directory as the GHOST executable to do an HD simulation in
! an anisotropic domain with rotation and with passive scalars.

! Grid resolution
&grid
nx = 64
ny = 64
nz = 128
/

! Boz size, if not present GHOST uses a 2.pi cubic box
&boxparams
Lx = 1.00        ! Length of the box in x
Ly = 1.00        ! Length of the box in y
Lz = 2.00        ! Length of the box in z
/

! General configuration flags
&status
idir = "outs"
odir = "outs"
stat = 0         ! last binary file if restarting an old run
mult = 1         ! decreases the time step
bench = 0        ! benchmark mode if 1
outs = 0         ! controls the amount of binary output
dt = 1e-3        ! time step
step = 501       ! total number of steps
tstep = 250      ! number of steps between binary output
sstep = 250      ! number of steps between spectrum output
cstep = 5        ! number of steps between writing global quantities
cort = 0.1       ! global correlation time for random forcing methods
seed = 1000      ! global seed for random number generators
/

! Time stepping method
&stepper
sname  = "TRADITIONAL" ! TRADITIONAL or GEXRK
norder = 2             ! order
/

! Solver
&pdes
solver = "HD"    ! Solver name, reads a namelist with the same name
/

! HD solver specific parameters
&HD
nu  = 3.e-3      ! kinematic viscosity
dorot = .TRUE.   ! do rotation
omegax = 0.0     ! rotation in x (ignored if dorot is FALSE)
omegay = 0.0     ! rotation in y (ignored if dorot is FALSE)
omegaz = 5.0     ! rotation in z (ignored if dorot is FALSE)
npassive = 3     ! number of passive scalars
spectlod = 2     ! spectral output level of detail [1-3]
/

! Parameters for the passive scalar (we set up npassive parameters)
! Passive scalar diffuvities when npassive > 0, separated by commas.
&passive
kappa = 1.3e-2, 2.1e-2, 5e-2 ! we have npassive = 3
/

! Initial conditions. List separated by ';' to set up ICs. 
! For v, ICs can be: read_v, null_v, tg_v, abc_v, random_v
! For passive sc., ICs can be: read_s, constant_s, puff_s, random_s
! Use "read_v;read_s" if restarting from a previous file with
! stat > 0. If stat > 0 and some ICs are not "read_?", GHOST resets
! that field, e.g., "read_v;puff_s" resets the passive scalar.
&initial_conditions
iclist = "null_v;constant_s"
/

! Forcing. List separated by ';', each forcing is a pair of
! methods separated by ',': an initial forcing, and an update scheme
! Forcings for v: null_fv, tg_fv, abc_fv, random_fv
! Updates for fv: constant_fv, shift_fv, shuffle_fv
! Forcings for s: null_fs, puff_fs, random_fs
! Updates for fs: constant_fs, shift_fs
&forcing
forces = "random_fv,shift_fv;random_fs,shift_fs"
/

! IC and forcing specific parameters, in namelists with their names:
! Parameters for random v forcing
&random_fv
f0 = 1.00        ! amplitude of the mechanical forcing
kdn = 1          ! minimum wavenumber
kup = 2          ! maximum wavenumber
alpha = 0.0      ! relative helicity
/

! Parameters for the passive scalar initial conditions
&constant_s
c0 = 1.00, 1.00, 1.00  ! Initial uniform concentrations (npassive=3)
/

! Parameters for random passive scalar forcing
&random_fs
f0 = 0.20, 0.40, 0.10  ! r.m.s. amplitude of the passive scalar sources
kdn = 1, 1, 1          ! minimum wavenumber
kup = 2, 2, 3          ! maximum wavenumber
/
