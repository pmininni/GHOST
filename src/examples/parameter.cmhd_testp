! Example of parameter.inp
! Rename this file as 'parameter.inp' and place it in the same
! directory as the GHOST executable to do a compressible MHD
! simulation (CMHD) with test particles (charged particles, testpart).

! Grid resolution
&grid
nx = 64
ny = 64
nz = 64
/

! Boz size, if not present GHOST uses a 2.pi cubic box
&boxparams
Lx = 1.00        ! Length of the box in x
Ly = 1.00        ! Length of the box in y
Lz = 1.00        ! Length of the box in z
/

! General configuration flags
&status
idir = "outs"
odir = "outs"
stat = 0         ! last binary file if restarting an old run
mult = 1         ! decreases the time step
bench = 0        ! benchmark mode if 1
outs = 0         ! controls the amount of binary output
dt = 1e-3        ! time step
step = 501       ! total number of steps
tstep = 250      ! number of steps between binary output
sstep = 250      ! number of steps between spectrum output
cstep = 5        ! number of steps between writing global quantities
cort = 0.2       ! global correlation time for random forcing methods
seed = 1000      ! global seed for random number generators
/

! Time stepping method
&stepper
sname  = "TRADITIONAL" ! TRADITIONAL or GEXRK
norder = 2             ! order
/

! Solver
&pdes
solver = "CMHD"  ! Solver name, reads a namelist with the same name
/

! CMHD solver specific parameters
&CMHD
nu  = 3.e-3      ! kinematic viscosity
eta = 3.e-3      ! magnetic diffusivity
nu2 = 0.0        ! bulk viscosity (see Stokeshyp)
Stokeshyp = 0    ! 0: nu2+nu/3, >0: Stokes hypothesis, <0: nu2 as given
smach = 0.5      ! sound Mach number (sound speed 1/smach at rho=1)
amach = 1.0      ! Alfvenic Mach number (Alfven speed 1/amach at rho=B=1)
gamma = 1.6667   ! polytropic index
doB0   = .FALSE. ! do MHD/Hall-MHD with guide field
dohall = .FALSE. ! do Hall-MHD
B0x = 0.0        ! guide field in x (ignored if doB0 is FALSE)
B0y = 0.0        ! guide field in y (ignored if doB0 is FALSE)
B0z = 0.0        ! guide field in z (ignored if doB0 is FALSE)
epsilon = 0.0    ! amplitude of the Hall term (ignored if dohall is FALSE)
npassive = 0     ! number of passive scalars
spectlod = 1     ! spectral output level of detail [1-3]
/

! Initial conditions. List separated by ';' to set up ICs. 
! For v, ICs can be: read_v, null_v, tg_v, abc_v, random_v
! For b, ICs can be: read_b, null_b, random_b
! For rho, ICs can be: read_as, uniform_as, puff_as, random_as
! Use "read_v;read_b;read_as" if restarting from a previous file with stat > 0
! If stat > 0 and some ICs are not "read_?", GHOST resets that field.
&initial_conditions
iclist = "abc_v;random_b;uniform_as"
/

! Forcing. List separated by ';', each forcing is a pair of
! methods separated by ',': an initial forcing, and an update scheme
! Forcings for v: null_fv, tg_fv, abc_fv, random_fv
! Updates for fv: constant_fv, shift_fv, shuffle_fv
! Forcings for b: null_fb, random_fb
! Updates for fb: constant_fb, shift_fb, shuffle_fb
&forcing
forces = "random_fv,shuffle_fv;random_fb,shuffle_fb"
/

! IC and forcing specific parameters, in namelists with their names:
! Parameters for ABC initial conditions
&abc_v
u0 = 1.00        ! normalized amplitude of the velocity 
kdn = 1.00       ! minimum wavenumber
kup = 2.00       ! maximum wavenumber
A = 1.00         ! A amplitude in ABC
B = 1.00         ! B amplitude in ABC
C = 1.00         ! C amplitude in ABC
/

! Parameters for random magnetic initial conditions
&random_b
b0 = 0.50        ! normalized amplitude of the magnetic field
kdn = 1          ! minimum wavenumber
kup = 2          ! maximum wavenumber
alpha = 0.0      ! relative helicity
corr  = 0.0      ! cross-correlation with the velocity
/

! Parameters for random velocity forcing
&random_fv
f0 = 1.00        ! amplitude of the mechanical forcing
kdn = 1          ! minimum wavenumber
kup = 2          ! maximum wavenumber
alpha = 0.0      ! relative helicity
/

! Parameters for random electromotive forcing
&random_fb
f0 = 1.00        ! amplitude of the mechanical forcing
kdn = 1          ! minimum wavenumber
kup = 2          ! maximum wavenumber
alpha = 0.0      ! relative helicity
corr  = 0.7      ! Cross-correlation between fv and fb
/

! Parameters for the uniform initial density
&uniform_as
c0 = 1.0         ! mean mass density
/

! Particles general configuration flags
&pstatus
maxparts   = 1000 ! Maximum number of particles
lgmult     = 10   ! Multiplier for part output (must divide tstep evenly)
ilgexchtype = 1   ! Boundary exchange type: 0 (nearest-neighbor); 1 (VDB)
ilgwrtunit = 1    ! write positions in box (=1) or grid (=0) units
ilgouttype = 0    ! Particle output type: 0=binary; 1=ASCII
ilgcoll    = 0    ! 1=binary collective I/O; 0=task 0 binary (posix) I/O
/

! Particle solver
&particles
psolver = "testpart" ! Solver name, reads a namelist with the same name
/

! testpart solver specific parameters. The particles evolve with
! dv_p/dt = gyrof [(v_p - u_e) x B + eta j], where B = curl(a) + B_0
! is the total magnetic field, j the current density, and u_e = u or
! u_e = u - dii j/rho (if dokinelv is .TRUE.; rho = 1 in MHD). In CMHD,
! dokinelp adds the electron pressure -(dii/2) Grad(p)/rho to E. eta,
! B_0 and the equation of state are taken from the fluid solver.
&testpart
gyrof = 1.0        ! Gyrofrequency for a unit magnetic field (q/m)
dii = 0.0          ! Ion inertial length (Hall epsilon, used if dokinelv)
dokinelv = .FALSE. ! Use the electron velocity in E if .TRUE.
dokinelp = .TRUE.  ! Add the electron pressure to E if .TRUE. (CMHD only)
partlod = 1        ! particle output level of detail
/

! Initial conditions for particles. List separated by ';' to set up ICs.
! For the position, ICs can be: read_x, user_x, random_x
! For the velocity, ICs can be: read_v, fluid_v, null_v, thermal_v
! Use "read_x;read_v" if restarting from a previous file with stat > 0
! If stat > 0 and the ICs are not "read", GHOST resets the particles.
&part_initial_conditions
iclist = "random_x;thermal_v"
/

! Parameters for the thermal velocity initial conditions
&thermal_v
vtherm = 1.0      ! Thermal speed of the particles
/
