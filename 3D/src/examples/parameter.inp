! Grid resolution
&grid
nx = 64
ny = 64
nz = 64
/

! Boz size, if not present GHOST uses a 2.pi cubic box
&boxparams
Lx = 1.00        ! Length of the box in x
Ly = 1.00        ! Length of the box in y
Lz = 1.00        ! Length of the box in z
/

! General configuration flags
&status
idir = "outs"
odir = "outs"
stat = 0         ! last binary file if restarting an old run
mult = 1         ! decreases the time step
bench = 1        ! benchmark mode if 1
outs = 0         ! controls the amount of output
dt = 1e-3        ! time step
step = 500       ! total number of steps
tstep = 250      ! number of steps between binary output
sstep = 250      ! number of steps between spectrum output
cstep = 5        ! number of steps between writing global quantities
/

! Solver
&pdes
solver = "HD"
/

! Solver specific parameters
&HD
nu = 3.e-4
dorot = .false.
npassive = 0
/

! Initial conditions
&initial_conditions
iclist = "null_v"
/

! Forcing
&forcing
forces = "tg_fv"
updates = "none"
/

! Parameters for Taylor-Green forcing
&tg_fv
f0 = 0.37714265  ! amplitude of the mechanical forcing
kdn = 2.00       ! minimum wavenumber
kup = 2.00       ! maximum wavenumber
/
